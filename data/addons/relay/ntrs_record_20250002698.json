{"copyright":{"disclosedInvention":false,"submissionId":20250002698,"containsThirdPartyMaterial":false,"containsIndication":false,"belongsToPublisher":false,"id":"c8d315486eab43b9b1d1e150013799c6","belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"belongsToAuthors":false},"subjectCategories":["Space Communications, Spacecraft Communications, Command and Tracking","Lunar and Planetary Science and Exploration"],"exportControl":{"isExportControl":"NO","submissionId":20250002698,"ear":"NO","id":"b30880d1cc4d4383bf9165ae6e491afb","itar":"NO"},"distributionDate":"2025-04-03T04:00:00.0000000+00:00","fundingNumbers":[{"number":"740128.06.01.02.01","submissionId":20250002698,"id":"0a874dddf8034079bef453a2bfa1f353","type":"WBS"}],"title":"NASA Lunar Communications Relay and Navigation Systems (LCRNS) Reference Constellation 3.1","stiType":"WHITE_PAPER","distribution":"PUBLIC","submittedDate":"2025-03-14T19:24:56.7621000+00:00","authorAffiliations":[{"organizationId":"e081fcbdcd5059fa8fa7b6c5c6a2c483","sequence":0,"submissionId":20250002698,"meta":{"author":{"orcidId":"","name":"Grant Ryden"},"organization":{"name":"Goddard Space Flight Center","location":"Greenbelt, United States"}},"id":"bfddf5bfbe2f42a088cd3b1e3ce8c50d","userType":"CIVIL","userId":"d6e49eb01eb148499cdf8e9c759e1913"},{"organizationId":"e081fcbdcd5059fa8fa7b6c5c6a2c483","sequence":1,"submissionId":20250002698,"meta":{"author":{"orcidId":"","name":"Michael Volle"},"organization":{"name":"Goddard Space Flight Center","location":"Greenbelt, United States"}},"id":"ecd873ea15a9487885bf4f4cbc28f693","userType":"CIVIL","userId":"8003e01ff9334f9a98d4ee90ab6025a0"}],"stiTypeDetails":"White Paper","technicalReviewType":"NASA_TECHNICAL_MANAGEMENT","modified":"2025-08-31T18:39:21.7150190+00:00","id":20250002698,"created":"2025-03-14T19:18:37.3022920+00:00","center":{"code":"GSFC","name":"Goddard Space Flight Center","id":"973fae00c3584b9fb4c762ae9870d0f6"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The LCRNS constellation is required to provide communications and navigation services to users in the region of the lunar south pole.  As such, many groups that represent end-users of LCRNS need trajectory data for the LCRNS constellation in order to perform analyses.  This document is provided to supply end-users with a set of states representing the government reference Constellation design for these analyses.  This reference design is not final; the final design choice belongs to Intuitive Machines (IM), under the contract to provide services to the Near Space Network (NSN).  Any subsequent design updates will replace this version and will include updated version numbers for clarity.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","cui":{"isCui":false,"submissionId":20250002698,"id":"546d11abde85456a9867f489457c12d1"},"publications":[{"submissionId":20250002698,"publisher":"National Aeronautics and Space Administration","id":"515aa3318a9540d29dafeb23597c609b","publicationName":"LCRNS Website","publicationDate":"2025-04-03T04:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/vnd.openxmlformats-officedocument.wordprocessingml.document","name":"LCRNS_Reference_Constellation_White_Paper_03_2025.docx","type":"STI","links":{"original":"/api/citations/20250002698/downloads/LCRNS_Reference_Constellation_White_Paper_03_2025.docx","fulltext":"/api/citations/20250002698/downloads/LCRNS_Reference_Constellation_White_Paper_03_2025.docx.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"}